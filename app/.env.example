# Copy to .env and fill in with your own values. NEVER commit the real .env.
# On Elastic Beanstalk set these under:
#   Configuration -> Software -> Environment properties

# --- Django ---
DJANGO_SECRET_KEY=generate-a-new-one-with-get_random_secret_key
EB_HOSTNAME=your-env.eba-xxxxxxxx.us-east-1.elasticbeanstalk.com

# --- RDS (PostgreSQL) ---
# EB injects these automatically when an RDS instance is attached to the environment.
RDS_DB_NAME=loans_db
RDS_USERNAME=postgres
RDS_PASSWORD=
RDS_HOSTNAME=your-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432

# --- AWS resources ---
AWS_S3_BUCKET=your-bucket-name
REKOGNITION_COLLECTION_ID=collection-id
# Contains your 12-digit AWS account id - keep it out of source control.
DECISION_WORKFLOW_ARN=arn:aws:states:us-east-1:000000000000:stateMachine:Decision_Workflow_ES
